# Server
PORT=8787
PUBLIC_BASE_URL=https://your-tunnel-domain.ngrok-free.dev

# Figma bridge (local plugin, no Figma PAT required)
FIGMA_MCP_URL=http://127.0.0.1:3845/mcp

# OAuth 2.0 / JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=your-username
ADMIN_PASSWORD=replace-with-a-strong-password
TOKEN_TTL_SECONDS=7200
